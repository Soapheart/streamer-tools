{
  "manifest_version": 3,
  "name": "Yandex Music OBS",
  "version": "1.0",

  "permissions": [
    "storage",
    "scripting",
    "offscreen"
  ],

  "host_permissions": [
    "https://music.yandex.ru/*",
    "https://music.yandex.com/*",
    "https://vk.ru/*",
    "https://vk.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://vk.ru/*",
        "https://vk.com/*"
      ],
      "js": ["content.js"]
    }
  ],

  "action": {
    "default_popup": "popup.html"
  }
}
